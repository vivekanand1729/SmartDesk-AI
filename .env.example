# Environment Variables for SmartDesk AI
# Copy this file to .env and fill in your API keys

# Required
OPENAI_API_KEY=your-openai-api-key-here

# Optional: LangFuse observability (sign up at langfuse.com)
LANGFUSE_PUBLIC_KEY=your-langfuse-public-key
LANGFUSE_SECRET_KEY=your-langfuse-secret-key
LANGFUSE_HOST=https://cloud.langfuse.com

# Optional: LangSmith tracing (sign up at smith.langchain.com)
LANGCHAIN_API_KEY=your-langchain-api-key
LANGCHAIN_TRACING_V2=true
LANGCHAIN_PROJECT=smartdesk-ai

# Ticket storage (local JSON by default)
TICKETS_FILE=tickets/tickets.json

# RAG configuration
FAISS_INDEX_PATH=index/faiss_index
SIMILARITY_THRESHOLD=0.40
